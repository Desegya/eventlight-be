# Copy to .env for local development (docker-compose.yml reads it too).
# In production, set these as real environment variables on your host
# (Railway/Render/Fly/etc.) or in .env.prod for docker-compose.prod.yml.

# Django
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Comma-separated origins the CSRF middleware should trust — must include the
# deployed frontend's origin, e.g. https://eventlight.vercel.app, since the SPA
# submits a CSRF header on every mutating request. Defaults to the local Vite
# dev origin; production MUST override this or every POST/PATCH/DELETE from
# the frontend will get a 403 (Origin checking failed).
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# CORS — comma-separated list of frontend origins allowed to call this API.
# Same rule as above: must match the deployed frontend's real origin in prod.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database — leave unset locally to fall back to SQLite. In production, set to
# a Postgres URL, e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Media storage — when set, event images are uploaded to Cloudinary instead of
# local disk. Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Email — ZeptoMail REST API
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_ADDRESS=noreply@dezzi.dev
ZEPTOMAIL_FROM_NAME=EventLight

# URL of the deployed frontend — used to build links in emails (password reset, etc.)
FRONTEND_URL=http://localhost:5173

PASSWORD_RESET_TIMEOUT_SECONDS=3600

# Timezone used to format dates in emails (storage is always UTC)
DISPLAY_TIME_ZONE=Africa/Lagos

# Email delivery runs on a background thread after the DB commit. Set false to
# send inline (simpler to debug, but slow requests when the mail API is slow).
EMAIL_SEND_ASYNC=true

# Production only -----------------------------------------------------------
# Reverse proxies in front of gunicorn that append to X-Forwarded-For.
# 1 on Railway/Render/Heroku. Rate limiting trusts the client IP that many
# entries from the right; a wrong value lets clients spoof their IP.
NUM_TRUSTED_PROXIES=1
# HTTPS redirect and HSTS (defaults shown). Health checks are exempt.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=2592000
# gunicorn worker count used by the Docker image
WEB_CONCURRENCY=3

# Error monitoring (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
