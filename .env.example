# Development environment; used by docker-compose.yml
# Copy to .env and edit:  cp .env.example .env

# Django
SECRET_KEY=dev-insecure-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional integrations (leave blank to disable)
CLOUDINARY_URL=
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_ADDRESS=noreply@dezzi.dev
ZEPTOMAIL_FROM_NAME=EventLight
