# Production environment; used by docker-compose.prod.yml
# Copy to .env.prod and fill in REAL secrets:  cp .env.prod.example .env.prod
# IMPORTANT: never commit .env.prod to git (it is gitignored via .env.*).

# --- Required ---
SECRET_KEY=replace-with-a-strong-random-secret-key
# External/managed Postgres. Use sslmode=require for managed DBs.
DATABASE_URL=postgres://USER:PASSWORD@your-db-host:5432/DBNAME?sslmode=require
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# --- Networking ---
# Host port to expose (default 8000). Put behind a reverse proxy / load balancer.
WEB_PORT=8000
PORT=8000

# --- Frontend / CORS ---
CORS_ALLOWED_ORIGINS=https://your-domain.com
FRONTEND_URL=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# --- Optional integrations ---
CLOUDINARY_URL=
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_ADDRESS=noreply@your-domain.com
ZEPTOMAIL_FROM_NAME=EventLight

# --- Proxies ---
# Reverse proxies in front of gunicorn that append X-Forwarded-For (rate limiting).
NUM_TRUSTED_PROXIES=1

# --- Security (defaults shown; override only if needed) ---
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=2592000

# --- Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
DJANGO_LOG_LEVEL=INFO
API_LOG_LEVEL=INFO
